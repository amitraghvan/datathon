# ========================================================
# EduPulse AI — Environment Configuration Template
# ========================================================

# ── Core Environment & Logging ───────────────────────────
APP_ENV=development
LOG_LEVEL=INFO

# ── Server Configuration ────────────────────────────────
HOST=127.0.0.1
PORT=8000

# ── Data Warehouse & Pipeline Paths ─────────────────────
DATA_RAW_DIR=data/raw
DATA_PROCESSED_DIR=data/processed
DUCKDB_PATH=data/processed/edupulse.duckdb

# ── Llama 3.1 / LLM Provider Configuration ───────────────
# Supported providers: Groq, Together, Ollama, OpenAI-compatible
LLAMA_API_KEY=your_llama_api_key_here
LLAMA_BASE_URL=https://api.groq.com/openai/v1
LLAMA_MODEL=llama-3.1-70b-versatile
LLAMA_TIMEOUT_SECONDS=30
LLAMA_TEMPERATURE=0
LLAMA_MAX_TOKENS=2048

# ── Optional Fallback Provider ───────────────────────────
OPENAI_API_KEY=

