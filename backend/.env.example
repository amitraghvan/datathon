# ========================================================
# EduPulse AI — Backend Environment Configuration
# ========================================================
# Copy this file to .env and fill in values.
# NEVER commit .env files with real credentials.

# ── Llama 3.1 LLM Configuration ──────────────────────
# Provider: Groq, Together AI, or any OpenAI-compatible endpoint
LLAMA_API_KEY=your_llama_api_key_here
LLAMA_BASE_URL=https://api.groq.com/openai/v1
LLAMA_MODEL=llama-3.1-70b-versatile
LLAMA_TIMEOUT_SECONDS=30
LLAMA_TEMPERATURE=0
LLAMA_MAX_TOKENS=2048

# ── Optional: Legacy OpenAI Configuration ─────────────
# Only used if LLAMA_API_KEY is not set
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

# ── Server Configuration ─────────────────────────────
HOST=127.0.0.1
PORT=8000
